#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["python-dotenv==1.1.1"]
# ///
import argparse
import os
from pathlib import Path
from urllib.parse import urlparse

from dotenv import dotenv_values


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--credentials-file", type=Path, required=True)
    parser.add_argument("--api-url", required=True)
    parser.add_argument("--http", action="store_true")
    parser.add_argument("--tailscale-login")
    parser.add_argument("--bind-address", default="127.0.0.1")
    parser.add_argument("--chaos-state", type=Path)
    args = parser.parse_args()
    target = urlparse(args.api_url)
    credentials = dotenv_values(args.credentials_file, interpolate=False)
    worker_target = credentials.get("PREFECT_API_URL")
    domain = credentials.get("DOMAIN")
    if worker_target:
        if worker_target != args.api_url:
            raise SystemExit("MCP target must match the worker environment's API URL")
        domain = urlparse(worker_target).hostname
    if target.scheme != "https" or target.hostname != domain:
        raise SystemExit("MCP target must match the credentials file's HTTPS domain")
    if target.path.rstrip("/") != "/api" or target.username or target.password:
        raise SystemExit("MCP target must be an API URL without embedded credentials")
    auth = credentials.get("AUTH_STRING") or credentials.get("PREFECT_API_AUTH_STRING")
    if not auth or ":" not in auth:
        raise SystemExit("credentials file must supply AUTH_STRING")
    environment = {
        key: value
        for key, value in os.environ.items()
        if key in {"PATH", "HOME", "LANG", "TMPDIR", "UV_CACHE_DIR", "SSL_CERT_FILE"}
    }
    environment.update(
        PREFECT_API_URL=args.api_url,
        PREFECT_API_AUTH_STRING=auth,
        PREFECT_SERVER_ALLOW_EPHEMERAL_MODE="false",
        PREFECT_MCP_CLOUD_ENABLED="false",
    )
    if args.http:
        if not args.tailscale_login:
            raise SystemExit("HTTP mode requires an allowed Tailscale login")
        environment["PREFECT_MCP_TAILSCALE_LOGIN"] = args.tailscale_login
        environment["PREFECT_MCP_BIND_ADDRESS"] = args.bind_address
        if args.chaos_state:
            environment["PREFECT_MCP_CHAOS_STATE"] = str(args.chaos_state.resolve())
    root = str(Path(__file__).resolve().parents[1])
    os.chdir(root)
    os.execvpe(
        "uv",
        [
            "uv",
            "run",
            "--frozen",
            "--no-dev",
            "--project",
            root,
            *(
                ["python", "-m", "prefect_mcp_server.selfhosted_http"]
                if args.http
                else ["prefect-mcp-server"]
            ),
        ],
        environment,
    )


if __name__ == "__main__":
    main()
